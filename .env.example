# Server-side support mail settings. Keep the real password in hosting secrets.
# Accounts require a MySQL database and a random signing secret. The local
# PowerShell setup generates these in ignored .env.local; production uses host secrets.
DATABASE_URL=
MANUS_JWT_SECRET=
# Set the public HTTPS origin in production if it differs from the published URL.
BASIRA_PUBLIC_URL=
# Optional OAuth credentials. Provider buttons stay disabled until complete.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

SUPPORT_SMTP_HOST=smtp.gmail.com
SUPPORT_SMTP_PORT=587
SUPPORT_SMTP_SECURE=false
SUPPORT_SMTP_USER=aurum.nexus.r1@gmail.com
SUPPORT_SMTP_PASSWORD=
SUPPORT_EMAIL_FROM=aurum.nexus.r1@gmail.com
SUPPORT_EMAIL_TO=aurum.nexus.r1@gmail.com

# Premium speech is OFF unless explicitly enabled. Keep all values server-side.
PREMIUM_TTS_ENABLED=false
GOOGLE_TTS_ENABLED=false
AZURE_TTS_ENABLED=false
# Per-process ceilings: 60 req/user/min, 20000 chars/user/min,
# 200000 chars/user/UTC day, 1000000 chars/instance/UTC day,
# 120 req/IP/min, 8 concurrent.
TTS_USER_REQUESTS_PER_MINUTE=12
TTS_USER_CHARACTERS_PER_MINUTE=8000
TTS_USER_CHARACTERS_PER_DAY=50000
TTS_GLOBAL_CHARACTERS_PER_DAY=250000
TTS_IP_REQUESTS_PER_MINUTE=40
TTS_MAX_CONCURRENT=4
# Backend only. Configure Google ADC with a service account permitted to call Cloud TTS.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
# Azure Speech resource key and region for ar-SA neural voices.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
